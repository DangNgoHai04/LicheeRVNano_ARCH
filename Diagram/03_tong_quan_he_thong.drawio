                <mxCell id="r0c0" value="Tài nguyên phần cứng" style="whiteSpace=wrap;html=0;fontSize=14;spacing=10;align=left;fillColor=#dae8fc;strokeColor=#b8c4d1;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry as="geometry" x="20" y="95" width="220" height="65"/>
                </mxCell>
                <mxCell id="r0c1" value="Chủ sở hữu" style="whiteSpace=wrap;html=0;fontSize=14;spacing=10;align=left;fillColor=#dae8fc;strokeColor=#b8c4d1;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry as="geometry" x="240" y="95" width="350" height="65"/>
                </mxCell>
                <mxCell id="r0c2" value="Cấu hình cô lập &amp; ghi chú" style="whiteSpace=wrap;html=0;fontSize=14;spacing=10;align=left;fillColor=#dae8fc;strokeColor=#b8c4d1;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry as="geometry" x="590" y="95" width="700" height="65"/>
                </mxCell>
                <mxCell id="r1c0" value="SPI0 (0x04180000) &amp; PAD_MIPI_TX* (FPC2 14/15/17/18)" style="whiteSpace=wrap;html=0;fontSize=14;spacing=10;align=left;fillColor=#f5f7fa;strokeColor=#b8c4d1;" parent="1" vertex="1">
                    <mxGeometry as="geometry" x="20" y="160" width="220" height="87"/>
                </mxCell>
                <mxCell id="r1c1" value="FreeRTOS C906L" style="whiteSpace=wrap;html=0;fontSize=14;spacing=10;align=left;fillColor=#f5f7fa;strokeColor=#b8c4d1;" parent="1" vertex="1">
                    <mxGeometry as="geometry" x="240" y="160" width="350" height="87"/>
                </mxCell>
                <mxCell id="r1c2" value="Linux DTS đặt &amp;spi0 { status = &quot;disabled&quot;; }; (nạp qua rawimages/boot.sd FIT Image). RTOS mở khóa MIPI DSI D-PHY Bypass (0x0A0D1000), mux SPI0 (Func 6) và GPIOC17 CS (Func 3)." style="whiteSpace=wrap;html=0;fontSize=14;spacing=10;align=left;fillColor=#f5f7fa;strokeColor=#b8c4d1;" parent="1" vertex="1">
                    <mxGeometry as="geometry" x="590" y="160" width="700" height="87"/>
                </mxCell>
                <mxCell id="r2c0" value="I2C5 (GPIOA15 SCL, GPIOA27 SDA)" style="whiteSpace=wrap;html=0;fontSize=14;spacing=10;align=left;fillColor=#ffffff;strokeColor=#b8c4d1;" parent="1" vertex="1">
                    <mxGeometry as="geometry" x="20" y="247" width="220" height="66"/>
                </mxCell>
                <mxCell id="r2c1" value="FreeRTOS C906L" style="whiteSpace=wrap;html=0;fontSize=14;spacing=10;align=left;fillColor=#ffffff;strokeColor=#b8c4d1;" parent="1" vertex="1">
                    <mxGeometry as="geometry" x="240" y="247" width="350" height="66"/>
                </mxCell>
                <mxCell id="r2c2" value="Linux tắt i2c5. T0 Soft-I2C chỉ khởi tạo khi thermal_bridge xác nhận cờ --resources-owned (THERMAL_GPIO_OWNED); bật pull-up nội (0x44) và giữ kiểu open-drain." style="whiteSpace=wrap;html=0;fontSize=14;spacing=10;align=left;fillColor=#ffffff;strokeColor=#b8c4d1;" parent="1" vertex="1">
                    <mxGeometry as="geometry" x="590" y="247" width="700" height="66"/>
                </mxCell>
                <mxCell id="r3c0" value="RTOS Reserved RAM (0x8FE00000..0x8FFFFFFF)" style="whiteSpace=wrap;html=0;fontSize=14;spacing=10;align=left;fillColor=#f5f7fa;strokeColor=#b8c4d1;" parent="1" vertex="1">
                    <mxGeometry as="geometry" x="20" y="313" width="220" height="87"/>
                </mxCell>
                <mxCell id="r3c1" value="C906L ghi / C906B đọc" style="whiteSpace=wrap;html=0;fontSize=14;spacing=10;align=left;fillColor=#f5f7fa;strokeColor=#b8c4d1;" parent="1" vertex="1">
                    <mxGeometry as="geometry" x="240" y="313" width="350" height="87"/>
                </mxCell>
                <mxCell id="r3c2" value="C906L chứa firmware cvirtos.bin + buffer reply (tối đa 64 + 196,608 B) và flush_dcache_range trước khi trả Mailbox. C906B Linux chỉ đọc qua mmap(/dev/mem) sau khi nhận phản hồi Mailbox." style="whiteSpace=wrap;html=0;fontSize=14;spacing=10;align=left;fillColor=#f5f7fa;strokeColor=#b8c4d1;" parent="1" vertex="1">
                    <mxGeometry as="geometry" x="590" y="313" width="700" height="87"/>
                </mxCell>
                <mxCell id="r4c0" value="Hardware Mailbox (rtos_cmdqu)" style="whiteSpace=wrap;html=0;fontSize=14;spacing=10;align=left;fillColor=#ffffff;strokeColor=#b8c4d1;" parent="1" vertex="1">
                    <mxGeometry as="geometry" x="20" y="400" width="220" height="66"/>
                </mxCell>
                <mxCell id="r4c1" value="Dùng chung 2 nhân" style="whiteSpace=wrap;html=0;fontSize=14;spacing=10;align=left;fillColor=#ffffff;strokeColor=#b8c4d1;" parent="1" vertex="1">
                    <mxGeometry as="geometry" x="240" y="400" width="350" height="66"/>
                </mxCell>
                <mxCell id="r4c2" value="Kênh THERMAL_IP: Linux gọi rtos_cmdqu_send_wait (polling 5 ms), RTOS gọi comm_poll_mailbox() trong prvCmdQuRunTask (không sửa nhân freertos/Source/...)." style="whiteSpace=wrap;html=0;fontSize=14;spacing=10;align=left;fillColor=#ffffff;strokeColor=#b8c4d1;" parent="1" vertex="1">
                    <mxGeometry as="geometry" x="590" y="400" width="700" height="66"/>
                </mxCell>
                <mxCell id="r5c0" value="Mạng USB Ethernet (usb0 = 10.250.50.1) / Wi-Fi (wlan0)" style="whiteSpace=wrap;html=0;fontSize=14;spacing=10;align=left;fillColor=#f5f7fa;strokeColor=#b8c4d1;" parent="1" vertex="1">
                    <mxGeometry as="geometry" x="20" y="466" width="220" height="87"/>
                </mxCell>
                <mxCell id="r5c1" value="Linux C906B" style="whiteSpace=wrap;html=0;fontSize=14;spacing=10;align=left;fillColor=#f5f7fa;strokeColor=#b8c4d1;" parent="1" vertex="1">
